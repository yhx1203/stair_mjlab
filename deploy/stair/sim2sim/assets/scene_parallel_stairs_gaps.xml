<mujoco model="wide high stairs and three gaps">
  <!-- Single route facing +X at y=0.
       Six rises -> four platforms / three gaps -> down stairs.
       Rise=0.18; top=1.08.
       Width=4, tread=0.30; platforms=1/0.8/0.8/1, bottom=ground z=0.
       Gap widths increase along +X: 0.30, 0.40, 0.50.
       Gap X intervals: [4,4.3], [5.1,5.5], [6.3,6.8].
       Spawn offset: (0,0,0). -->
  <statistic center="4.8 0 0.4" extent="13" />
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="-130" elevation="-30" />
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.20 0.30 0.40" rgb2="0.10 0.20 0.30" markrgb="0.8 0.8 0.8" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />
    <material name="high_stairs" rgba="0.72 0.56 0.36 1" />
    <material name="high_landing" rgba="0.51 0.36 0.21 1" />
  </asset>
  <default>
    <geom contype="1" conaffinity="1" condim="3" friction="0.6 0.005 0.0001" group="0" />
  </default>
  <worldbody>
    <light pos="3.4 0 9" dir="0 0 -1" directional="true" />
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane" />
    <!-- high: up stairs, three gaps, down stairs. -->
    <geom name="high_up_1" type="box" pos="1.350 0 0.090" size="0.15 2 0.090" material="high_stairs" />
    <geom name="high_up_2" type="box" pos="1.650 0 0.180" size="0.15 2 0.180" material="high_stairs" />
    <geom name="high_up_3" type="box" pos="1.950 0 0.270" size="0.15 2 0.270" material="high_stairs" />
    <geom name="high_up_4" type="box" pos="2.250 0 0.360" size="0.15 2 0.360" material="high_stairs" />
    <geom name="high_up_5" type="box" pos="2.550 0 0.450" size="0.15 2 0.450" material="high_stairs" />
    <geom name="high_up_6" type="box" pos="2.850 0 0.540" size="0.15 2 0.540" material="high_stairs" />
    <geom name="high_platform_a" type="box" pos="3.5 0 0.540" size="0.5 2 0.540" material="high_landing" />
    <geom name="high_platform_b" type="box" pos="4.7 0 0.540" size="0.4 2 0.540" material="high_landing" />
    <geom name="high_platform_c" type="box" pos="5.900 0 0.540" size="0.4 2 0.540" material="high_landing" />
    <geom name="high_platform_d" type="box" pos="7.300 0 0.540" size="0.5 2 0.540" material="high_landing" />
    <geom name="high_down_1" type="box" pos="7.950 0 0.450" size="0.15 2 0.450" material="high_stairs" />
    <geom name="high_down_2" type="box" pos="8.250 0 0.360" size="0.15 2 0.360" material="high_stairs" />
    <geom name="high_down_3" type="box" pos="8.550 0 0.270" size="0.15 2 0.270" material="high_stairs" />
    <geom name="high_down_4" type="box" pos="8.850 0 0.180" size="0.15 2 0.180" material="high_stairs" />
    <geom name="high_down_5" type="box" pos="9.150 0 0.090" size="0.15 2 0.090" material="high_stairs" />
  </worldbody>
</mujoco>
